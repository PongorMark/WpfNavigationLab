<Page x:Class="WpfNavigationLab.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F8FAFC">

    <Grid Margin="40">
        <StackPanel>
            <TextBlock Text="Főoldal"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>

            <TextBlock Text="Üdvözöl a WPF Navigation Lab!"
                       FontSize="16"
                       Foreground="#64748B"
                       Margin="0,10,0,25"/>

            <Border Background="White"
                    CornerRadius="15"
                    Padding="25">

                <StackPanel>
                    <TextBlock Text="Page navigáció"
                               FontSize="20"
                               FontWeight="Bold"/>

                    <TextBlock Text="A menü segítségével különböző oldalakat nyithatsz meg ugyanabban az ablakban."
                               TextWrapping="Wrap"
                               Margin="0,10,0,20"/>

                    <Button Content="Tovább a Profil oldalra"
                            Height="45"
                            Click="GoToProfile_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
