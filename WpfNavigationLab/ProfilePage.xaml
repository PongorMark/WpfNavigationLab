<Page x:Class="WpfNavigationLab.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F8FAFC">

    <Grid Margin="40">
        <StackPanel>
            <TextBlock Text="Profil"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>

            <TextBlock Text="Add meg a profiladataidat."
                       FontSize="16"
                       Foreground="#64748B"
                       Margin="0,10,0,25"/>

            <TextBlock Text="Név"
                       FontWeight="Bold"/>

            <TextBox x:Name="txtName"
                     Height="40"
                     FontSize="16"
                     Padding="8"
                     Margin="0,5,0,15"/>

            <TextBlock Text="E-mail"
                       FontWeight="Bold"/>

            <TextBox x:Name="txtEmail"
                     Height="40"
                     FontSize="16"
                     Padding="8"
                     Margin="0,5,0,20"/>

            <Button Content="Adatok ellenőrzése"
                    Height="45"
                    Margin="0,0,0,10"
                    Click="Save_Click"/>

            <Button Content="Tovább a Beállításokhoz"
                    Height="45"
                    Margin="0,0,0,10"
                    Click="Settings_Click"/>

            <Button Content="Vissza"
                    Height="45"
                    Click="Back_Click"/>
        </StackPanel>
    </Grid>
</Page>
